{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "techscope-stock-dashboard",
  "main": "./src/worker.js",
  "compatibility_date": "2026-08-05",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "STOCK_DATA",
      "bucket_name": "techscope-stock-data"
    }
  ],
  "triggers": {
    "crons": ["30 1 * * 2-6"]
  },
  "vars": {
    "PRICE_SYNC_HOURS": "6",
    "META_TTL_DAYS": "7",
    "MAX_CRON_STOCKS": "20"
  }
}
